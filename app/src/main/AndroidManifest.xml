<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P5.10: used ONLY by the GIF/sticker panel to query GIPHY and fetch previews.
         The typing path never touches the network — see PRIVACY.md and PrivacyGuaranteeTest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- P5.4: keypress vibration at a user-chosen strength (Vibrator.vibrate needs this; the
         permission-free View.performHapticFeedback has no strength control). Normal-level
         permission: no prompt, no data access. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- allowBackup=false: the user dictionary / bigrams / per-app language files must never
         reach Google Drive auto-backup — PRIVACY.md promises nothing typed leaves the device. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kinetic">

        <!-- The keyboard (Input Method Editor) -->
        <service
            android:name=".service.KeyboardImeService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- P5.10: exposes downloaded GIFs to the host app via commitContent -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kinetic.keyboard.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Setup / launcher screen: enable and pick the keyboard, then test typing -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
